    {
        "id": "06d604384b2029aa",
        "type": "function",
        "z": "1fe0900c2c4e1691",
        "name": "Emit one msg per item",
        "func": "// If gateway publishes an array, emit one message per item; otherwise pass through.\nconst p = msg.payload;\nif (Array.isArray(p)) {\n  for (const item of p) node.send({ ...msg, payload: item });\n  return null;\n}\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 480,
        "y": 460,
        "wires": [
            [
                "8a9b751b18824287"
            ]
        ]
    },
    {
        "id": "8a9b751b18824287",
        "type": "function",
        "z": "1fe0900c2c4e1691",
        "name": "Build /Tracking/<trolleyId> + set",
        "func": "// Parse if payload is string\nif (typeof msg.payload === 'string') {\n  try { msg.payload = JSON.parse(msg.payload); } catch (e) {}\n}\nconst p = msg.payload || {};\n\n// Extract ID and zone\nconst trolleyId = p.trolleyId || 'UNKNOWN_TROLLEY';\nconst zoneId = p.zoneId || (msg.topic.split('/')[2] || 'UNKNOWN_ZONE');\n\n// Keep only useful data\nmsg.payload = {\n  zoneId: zoneId,\n  latitude: p.latitude || null,\n  longitude: p.longitude || null,\n  rssi: p.rssi || null,\n  timestamp: p.timestamp || new Date().toISOString()\n};\n\n// Firebase path and overwrite mode\nmsg.topic = `Tracking/${String(trolleyId)}`;\nmsg.method = 'set';\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 710,
        "y": 460,
        "wires": [
            [
                "6cea620aa5bb67d5"
            ]
        ]
    },
